# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/nova_ai_assistant

# Authentication
JWT_SECRET=super_secret_jwt_key_nova_ai_change_in_production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Optional External AI API integrations (Gemini, OpenAI, Weather, etc.)
GEMINI_API_KEY=
OPENAI_API_KEY=
WEATHER_API_KEY=
SERP_API_KEY=
